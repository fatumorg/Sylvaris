sleep 1.5
syl polkit preview
sleep 1
syl state polkit
shot polkit
bg sylvaris watch > "$HOME/watch.log"
bg wtype -k Shift_L zq8
sleep 0.6
syl state
check ! grep -q zq8 "$OUT/ipc.log" "$HOME/watch.log"
bg wtype -k Shift_L wrong -k Return
sleep 1
syl state polkit
shot polkit-wrong
bg wtype -k Shift_L right -k Return
sleep 1
syl state polkit
check ! grep -q zq8 "$OUT/ipc.log" "$OUT/shell.log" "$HOME/watch.log"
