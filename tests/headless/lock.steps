sway create_output
sway output HEADLESS-2 resolution 1920x1080 position 0 690
sway output HEADLESS-1 position 1920 0
sleep 1.5
bg sylvaris watch > "$HOME/watch.log"
sleep 0.5
syl lock now
sleep 2.5
syl state lock
check grep -q '"locked":true,"secure":true' "$XDG_RUNTIME_DIR/sylvaris/lock.json"
shot lock
bg wtype -k Shift_L wrong -k Return
sleep 1.5
syl state lock
check grep -q '"message":"Wrong password"' "$XDG_RUNTIME_DIR/sylvaris/lock.json"
shot lock-wrong
bg wtype -k Shift_L zq8Unlock
sleep 0.8
syl state
check ! grep -q zq8 "$OUT/ipc.log" "$HOME/watch.log" "$XDG_RUNTIME_DIR/sylvaris/lock.json"
bg wtype -k Shift_L -k Return
sleep 1.5
syl state lock
check grep -q '"locked":false' "$XDG_RUNTIME_DIR/sylvaris/lock.json"
wait ! test -e "$XDG_RUNTIME_DIR/sylvaris/lock.sock"
syl lock now
sleep 2.5
shot lock-relock
check grep -q '"locked":true' "$XDG_RUNTIME_DIR/sylvaris/lock.json"
syl lock now
sleep 7
syl state lock
check tail -n 3 "$OUT/ipc.log" | grep -q '"locked":true,"secure":true,"busy":false,"message":"","error":false'
bg wtype -k Shift_L zq8Unlock -k Return
sleep 0.35
syl lock now
sleep 2.5
syl state lock
check tail -n 3 "$OUT/ipc.log" | grep -q '"locked":true,"secure":true'
killshell
sleep 1.5
check grep -q '"locked":true' "$XDG_RUNTIME_DIR/sylvaris/lock.json"
shot lock-orphan
bg wtype -k Shift_L zq8Unlock -k Return
sleep 1.5
check grep -q '"locked":false' "$XDG_RUNTIME_DIR/sylvaris/lock.json"
wait ! test -e "$XDG_RUNTIME_DIR/sylvaris/lock.sock"
shot lock-orphan-unlocked
check ! grep -q zq8 "$OUT/ipc.log" "$OUT/shell.log" "$HOME/watch.log"
check ! grep -rq zq8 "$OUT"/*.log "$XDG_RUNTIME_DIR"/sylvaris
