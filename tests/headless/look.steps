sleep 1.5
syl set motion.reduced true
syl center open
sleep 1.5
shot look-lumen
syl set look.preset ink
sleep 1
shot look-ink
syl set look.preset neon
sleep 1
shot look-neon
syl set look.preset frost
sleep 1
shot look-frost
syl set look.preset paper
sleep 1
shot look-paper
syl set look.preset classic
sleep 1
shot look-classic
check sylvaris state | grep -q '"material":"resin"'
syl look save Night Owl
sleep 1.5
check sylvaris look list | grep -q night-owl
syl look set ink
sleep 0.5
check sylvaris look state | grep -q '"preset":"ink"'
check sylvaris state | grep -q '"glass":{"values"'
syl look export /tmp/syl-look-export.json night-owl
check grep -q '"name": "Night Owl"' /tmp/syl-look-export.json
check sylvaris look import /tmp/syl-look-export.json 2>&1 | grep -q 'already have'
syl look set night-owl
sleep 0.5
check sylvaris look state | grep -q '"preset":"night-owl"'
shot wall-src
check id=$(sylvaris theme generate "$OUT/wall-src.png") && test -f "$HOME/.config/sylvaris/themes/$id.json" && sylvaris theme set "$id"
sleep 1.5
check sylvaris state | grep -q '"id":"wall-'
shot look-wall
check sylvaris set look.accent "#ff0088"
sleep 1
check ! sylvaris state | grep -q '"accent":"#c9702f"'
shot look-accent
