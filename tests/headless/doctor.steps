sleep 1
write sylvaris/settings.json {"version":1,"parts":{"diver":false},"clock":{"corner":"nowhere"}}
sleep 0.5
check sylvaris doctor > "$OUT/doctor.txt"
check grep -q '^Sylvaris [0-9.]* (commit ' "$OUT/doctor.txt"
check grep -q '^SylStack: SylStack' "$OUT/doctor.txt"
check grep -q '^Compositor: sway' "$OUT/doctor.txt"
check grep -q '^Parts off: diver, island$' "$OUT/doctor.txt"
check grep -q '^Missing tools' "$OUT/doctor.txt"
check grep -q '^Missing fonts: none$' "$OUT/doctor.txt"
check grep -q 'clock.corner: "nowhere" is not valid, using "top-center"' "$OUT/doctor.txt"
check grep -q "^config.json .*: ok$" "$OUT/doctor.txt"
check [ "$(cat "$HOME/.config/sylvaris/settings.json")" = '{"version":1,"parts":{"diver":false},"clock":{"corner":"nowhere"}}' ]
