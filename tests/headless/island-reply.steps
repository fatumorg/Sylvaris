sleep 1.5
syl set parts.island true
syl set island.media false
sleep 2.5
bg gdbus call --session --dest org.freedesktop.Notifications --object-path /org/freedesktop/Notifications --method org.freedesktop.Notifications.Notify Telegram 0 "" Ana "see you at 8?" '["inline-reply","Reply"]' '{}' 0 | sed 's/.* \([0-9]*\),.*/\1/' > "$OUT/id.txt"
sleep 1
check sylvaris island | grep -q '"kind":"message","label":"Ana"'
syl island reply
sleep 0.8
check sylvaris island state | grep -q '"replying":true'
shot island-reply
bg gdbus call --session --dest org.freedesktop.Notifications --object-path /org/freedesktop/Notifications --method org.freedesktop.Notifications.CloseNotification "$(cat "$OUT/id.txt")" >/dev/null
sleep 0.8
check sylvaris island state | grep -q '"replying":false'
check ! sylvaris island | grep -q '"kind":"message"'
bg gdbus call --session --dest org.freedesktop.Notifications --object-path /org/freedesktop/Notifications --method org.freedesktop.Notifications.Notify Telegram 0 "" Ola "hi" '["inline-reply","Reply"]' '{}' 0 >/dev/null
sleep 1
syl island reply
sleep 0.8
check sylvaris island state | grep -q '"replying":true'
bg wtype -k Shift_L -k Escape
sleep 0.8
check sylvaris island state | grep -q '"replying":false'
bg foot --app-id firefox -e sh -c 'head -n1 > "$OUT/typed.txt"'
sleep 1.5
bg notify-send -a firefox -A default=Open "Messenger" "messenger.com: Ana: lunch?" > "$OUT/web-action.txt"
sleep 1
check sylvaris island | grep -q '"kind":"message"'
syl island reply
sleep 0.8
check sylvaris island state | grep -q '"replying":true'
shot island-reply-web
syl island reply on my way
sleep 2.5
check grep -qx default "$OUT/web-action.txt"
check grep -qx 'on my way' "$OUT/typed.txt"
check ! sylvaris island | grep -q '"kind":"message"'
bg foot --app-id other -e sh -c 'head -n1 > "$OUT/stray.txt"'
sleep 1.5
bg notify-send -a firefox -A default=Open "Messenger" "messenger.com: Ola: still up?" > /dev/null
sleep 1
syl island reply
sleep 0.8
syl island reply not into the terminal
sleep 4
check test "$(wl-paste -n)" = "not into the terminal"
check ! test -s "$OUT/stray.txt"
check sylvaris state notifications | grep -q 'Reply copied'
bg notify-send -a firefox -A default=Open "Messenger" "messenger.com: Ana: one?" > /dev/null
sleep 1
syl island reply
sleep 0.8
syl island reply first one
sleep 0.3
bg notify-send -a firefox -A default=Open "Messenger" "messenger.com: Ola: two?" > /dev/null
sleep 1
syl island reply
sleep 0.8
syl island reply second one
sleep 4
check test "$(sylvaris state notifications | grep -o 'Reply copied' | wc -l)" -ge 3
check ! test -s "$OUT/stray.txt"
