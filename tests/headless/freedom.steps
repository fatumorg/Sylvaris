sleep 1.5
write sylvaris/settings.json {"version":1,"corners":{"enabled":true,"dwell":100,"actions":{"*:top-left":"look set ink","HEADLESS-1:bottom-right":{"command":["sh","-c","touch \"$HOME/corner-hit\""]}}}}
sleep 1.5
pointer move 1280 720
sleep 1
pointer move 1 1
sleep 1
check sylvaris look state | grep -q '"preset":"ink"'
pointer move 1280 720
pointer move 2559 1439
wait test -e "$HOME/corner-hit"
pointer move 1280 720
syl set corners.enabled false
syl look shuffle
sleep 1
check ! sylvaris look state | grep -q '"preset":"ink"'
syl set look.shuffle daily
wait test "$(cat "$HOME/.local/state/sylvaris/shuffle-day")" = "$(date +%F)"
check sylvaris get look.shuffle | grep -q daily
killshell
