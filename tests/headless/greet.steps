sleep 2
ipc state
check grep -q "\"theme\": *\"warm\"" "$OUT/ipc.log"
shot greet
bg wtype -k Shift_L zq8
sleep 0.6
ipc state
check ! grep -q zq8 "$OUT/ipc.log"
bg wtype -k Shift_L wrong -k Return
sleep 1.2
ipc state
shot greet-wrong
bg wtype -k Shift_L -k Down
sleep 0.4
bg wtype -k Shift_L -k F2
sleep 0.6
shot greet-sessions
bg wtype -k Shift_L -k Escape
sleep 0.4
ipc state
bg wtype -k Shift_L right -k Return
sleep 1.2
check ! grep -q zq8 "$OUT/ipc.log" "$OUT/shell.log"
