sleep 1.5
check mkdir -p /tmp/bm-a /tmp/bm-b /tmp/bm-c /tmp/bm-g1 /tmp/bm-g2 && mkdir -p "$HOME/.config/gtk-3.0" && printf 'file:///tmp/bm-g1 One\nfile:///tmp/bm-g2 Two\n' > "$HOME/.config/gtk-3.0/bookmarks"
syl files open /tmp/bm-a
sleep 1.5
syl files act bookmark
syl files go /tmp/bm-b
sleep 0.5
syl files act bookmark
syl files go /tmp/bm-c
sleep 0.5
syl files act bookmark
sleep 1
shot files-bookmarks-before
pointer move 77 429 mousedown 1 move 77 440 move 77 480 move 77 505 mouseup 1
sleep 1
check tr -d '\n ' < "$HOME/.config/sylvaris/settings.json" | grep -q '"bookmarks":\["/tmp/bm-b","/tmp/bm-c","/tmp/bm-a"\]'
check sylvaris files state | grep -q '"path":"/tmp/bm-c"'
shot files-bookmarks-after
pointer move 77 500 mousedown 1 move 77 490 move 77 450 move 77 420 mouseup 1
sleep 1
check tr -d '\n ' < "$HOME/.config/sylvaris/settings.json" | grep -q '"bookmarks":\["/tmp/bm-a","/tmp/bm-b","/tmp/bm-c"\]'
check sylvaris files state | grep -q '"path":"/tmp/bm-c"'
pointer move 77 572 mousedown 1 move 77 565 move 77 545 move 77 530 mouseup 1
sleep 1
check test "$(cat "$HOME/.config/gtk-3.0/bookmarks")" = "$(printf 'file:///tmp/bm-g2 Two\nfile:///tmp/bm-g1 One')"
check tr -d '\n ' < "$HOME/.config/sylvaris/settings.json" | grep -q '"bookmarks":\["/tmp/bm-a","/tmp/bm-b","/tmp/bm-c"\]'
shot files-bookmarks-gtk
pointer move 77 141 mousedown 1 move 77 150 move 77 190 move 77 215 mouseup 1
sleep 1
check tr -d '\n ' < "$HOME/.config/sylvaris/settings.json" | grep -q '"placeOrder":\["[^"]*/Desktop","[^"]*/Documents","[^"]*/home"'
shot files-places-moved
