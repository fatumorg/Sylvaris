sleep 1.5
check mkdir -p "$HOME/Docs/Sub" && printf 'a' > "$HOME/Docs/a.txt" && printf 'b' > "$HOME/Docs/b.txt"
bg sylvaris choose 0 0 0 "$HOME/Docs" "$OUT/open.out" > "$OUT/open.log" 2>&1; echo $? > "$OUT/open.rc"
sleep 2
check sylvaris files picker | grep -q '"open":true,"path":"[^"]*/Docs".*"pick":{"mode":"open","multiple":false'
check sylvaris files picker | grep -q '"items":\["Sub","a.txt","b.txt"\]'
shot files-pick-open
bg wtype -k Shift_L -s 400 -k Right -k Right -k Return
sleep 2
check test "$(cat "$OUT/open.out")" = "$HOME/Docs/a.txt"
check test "$(cat "$OUT/open.rc")" = 0
check sylvaris files picker | grep -q '"open":false,.*"pick":null}'
bg sylvaris choose 0 0 1 "$HOME/Docs/report.pdf" "$OUT/save.out" > "$OUT/save.log" 2>&1
sleep 2
check sylvaris files picker | grep -q '"pick":{"mode":"save","multiple":false,"name":"report.pdf"'
shot files-pick-save
bg wtype -k Shift_L -s 400 -k Return
sleep 2
check test "$(cat "$OUT/save.out")" = "$HOME/Docs/report.pdf"
bg sylvaris choose 0 0 1 "$HOME/Docs/a.txt" "$OUT/save2.out" > "$OUT/save2.log" 2>&1
sleep 2
bg wtype -k Shift_L -s 400 -k Return
sleep 1
check sylvaris files picker | grep -q '"dialog":"replace"'
shot files-pick-replace
bg wtype -k Shift_L -s 400 -k Return
sleep 2
check test "$(cat "$OUT/save2.out")" = "$HOME/Docs/a.txt"
bg sylvaris choose 1 0 0 "$HOME/Docs" "$OUT/many.out" > "$OUT/many.log" 2>&1
sleep 2
bg wtype -k Shift_L -s 400 -M ctrl -k a -m ctrl -k Return
sleep 2
check test "$(cat "$OUT/many.out")" = "$(printf '%s\n%s' "$HOME/Docs/a.txt" "$HOME/Docs/b.txt")"
bg sylvaris choose 0 1 0 "$HOME/Docs" "$OUT/dir.out" > "$OUT/dir.log" 2>&1
sleep 2
check sylvaris files picker | grep -q '"pick":{"mode":"folder"'
bg wtype -k Shift_L -s 400 -k Return
sleep 2
check test "$(cat "$OUT/dir.out")" = "$HOME/Docs"
bg sylvaris choose 0 0 0 "$HOME/Docs" "$OUT/cancel.out" > "$OUT/cancel.log" 2>&1; echo $? > "$OUT/cancel.rc"
sleep 2
bg wtype -k Shift_L -s 400 -k Escape
sleep 2
check test -f "$OUT/cancel.out" && test ! -s "$OUT/cancel.out" && test "$(cat "$OUT/cancel.rc")" = 0
check sylvaris files picker | grep -q '"open":false'
bg sylvaris choose 0 0 0 "$HOME/Docs" "$OUT/gone.out" > "$OUT/gone.log" 2>&1; echo done > "$OUT/gone.done"
sleep 2
syl set parts.files false
sleep 5
check test -f "$OUT/gone.done" && test ! -s "$OUT/gone.out"
