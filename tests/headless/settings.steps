sleep 1.5
syl settings open general
sleep 0.7
shot settings-general
syl settings open appearance
sleep 0.7
shot settings-appearance
syl settings open bar
sleep 0.7
shot settings-bar
syl settings open deck
sleep 0.7
shot settings-deck
syl settings open notifications
sleep 0.7
shot settings-notifications
syl settings open sound
sleep 0.7
shot settings-sound
syl settings open commands
sleep 0.7
shot settings-commands
syl state settingsPanel
syl center
sleep 0.6
shot center-gear
syl settings close
sleep 1
syl settings open
sleep 1.5
check sylvaris state settingsPanel | grep -q '"section":"commands","group":"advanced"'
bg wtype -k Shift_L -s 400 -k Escape
sleep 1.2
check sylvaris state settingsPanel | grep -q '"section":"","group":"advanced"'
bg wtype -k Shift_L -s 400 -k Tab
sleep 1
check sylvaris state settingsPanel | grep -q '"group":"system"'
shot settings-groups
bg wtype -k Shift_L -s 400 -M shift -k Tab -m shift
sleep 1
check sylvaris state settingsPanel | grep -q '"group":"advanced"'
syl settings open files
sleep 1
check sylvaris state settingsPanel | grep -q '"section":"files","group":"apps"'
syl settings open look
sleep 1.5
shot settings-look
check sylvaris state | grep -q '"section":"look"'
