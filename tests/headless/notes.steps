sleep 1.5
check printf 'one\r\ntwo\r\nthree' > "$HOME/crlf.txt" && printf 'ab\000cd' > "$HOME/blob.bin" && printf 'keep' > "$HOME/plain.txt"
syl notes open ~/crlf.txt
wait sylvaris notes state | grep -q '"eol":"crlf"'
bg wtype -k Shift_L -s 400 X
wait sylvaris notes state | grep -q '"dirty":true'
syl notes save
sleep 0.5
check printf 'Xone\r\ntwo\r\nthree' | cmp - "$HOME/crlf.txt"
check sylvaris notes state | grep -q '"dirty":false'
check sylvaris get notes.recent | grep -q 'crlf.txt'
bg wtype -k Shift_L -s 400 Y
sleep 2
check test "$(stat -c %a "$HOME/.local/state/sylvaris/notes")" = 700
check test "$(ls "$HOME/.local/state/sylvaris/notes" | wc -l)" = 1
check test "$(stat -c %a "$HOME/.local/state/sylvaris/notes/"*.swp)" = 600
shot notes
restart
sleep 2
syl notes open ~/crlf.txt
wait sylvaris notes state | grep -q '"recovered":1'
check sylvaris notes state | grep -q '"dirty":true,"readOnly":false,"why":"","eol":"crlf"[^}]*"recovered":true'
check printf 'Xone\r\ntwo\r\nthree' | cmp - "$HOME/crlf.txt"
shot notes-recovered
syl notes open ~/blob.bin
wait sylvaris notes state | grep -q '"title":"blob.bin","dirty":false,"readOnly":true'
check ! sylvaris notes save
syl notes open ~/plain.txt
wait sylvaris notes state | grep -q '"title":"plain.txt","dirty":false,"readOnly":false[^}]*"length":4'
check printf 'changed on disk' > "$HOME/plain.txt"
wait sylvaris notes state | grep -q '"title":"plain.txt","dirty":false,"readOnly":false[^}]*"length":15'
check i=0; while [ $i -lt 12000 ]; do echo "LOG  : General     f:$i> a game console line that keeps growing while it is open"; i=$((i+1)); done > "$HOME/console.txt"
syl notes open ~/console.txt
wait sylvaris notes state | grep -q '"title":"console.txt"'
bg i=0; while [ $i -lt 300 ]; do echo "LOG  : General     appended $i" >> "$HOME/console.txt"; i=$((i+1)); sleep 0.01; done
check n=0; slow=0; while [ $n -lt 10 ]; do a=$(date +%s%3N); sylvaris notes state >/dev/null; [ $(($(date +%s%3N) - a)) -gt 250 ] && slow=$((slow + 1)); n=$((n + 1)); sleep 0.2; done; [ $slow -le 2 ]
wait test "$(sylvaris notes state | grep -o '"title":"console.txt"[^}]*"length":[0-9]*' | grep -o '[0-9]*$')" = "$(wc -c < "$HOME/console.txt")" && grep -q 'appended 299' "$HOME/console.txt"
check printf 'def f(x):\n    return x + 1\n\nprint(f(41))\n' > "$HOME/demo.py"
syl notes open ~/demo.py
wait sylvaris notes state | grep -q '"title":"demo.py"[^}]*"language":"Python","highlighted":true'
check test -s "$HOME/.local/share/org.kde.syntax-highlighting/themes/sylvaris.theme"
shot notes-python
bg wtype -k Shift_L -s 400 -M ctrl -k f -m ctrl -s 400 x -s 300 -k Return
wait sylvaris notes state | grep -q '"find":{"shown":true,"replacing":false,"query":"x","matches":2,"at":0}'
shot notes-find
bg wtype -k Shift_L -s 400 -k Escape -s 300 -M ctrl -k g -m ctrl -s 400 3 -s 300 -k Return
wait sylvaris notes state | grep -q '"find":{"shown":false[^}]*}[^}]*"line":3'
check sylvaris notes state | grep -q '"title":"demo.py","dirty":false'
bg wtype -k Shift_L -s 400 -M ctrl -k equal -m ctrl
wait sylvaris notes state | grep -q '"zoom":1'
bg wtype -k Shift_L -s 400 -M ctrl -k 0 -m ctrl
wait sylvaris notes state | grep -q '"zoom":0'
syl notes new
wait sylvaris notes state | grep -q '"title":"Untitled 1"'
bg wtype -k Shift_L -s 400 -M ctrl -k w -m ctrl
sleep 1
check sylvaris notes state | grep -q '"asking":false'
check ! sylvaris notes state | grep -q 'Untitled 1'
syl notes window ~/plain.txt
wait test "$(sylvaris notes state | grep -o '"windows":[0-9]*')" = '"windows":2'
syl notes close
sleep 1
check sylvaris notes state | grep -q '"open":false'
check test "$(ls "$HOME/.local/state/sylvaris/notes" | wc -l)" = 1
