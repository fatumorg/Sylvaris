sleep 1.5
syl center open
sleep 1
shot compact
syl state
syl set center.hidden ["dnd","night"]
syl set center.volume false
sleep 1
shot compact-trimmed
check sylvaris get center.hidden | grep -q dnd
syl set center.hidden []
syl plugins enable fatest
syl plugins enable airpods
syl set center.extra ["fatest","airpods","screenshot","record","clip","lock"]
sleep 1.5
syl center open
sleep 1
shot compact-extra
check sylvaris get center.extra | grep -q airpods
syl set center.layout bento
sleep 1
syl center open
sleep 1
shot compact-bento
check sylvaris get center.layout | grep -q bento
