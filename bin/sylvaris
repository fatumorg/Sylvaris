#!/usr/bin/env bash
set -euo pipefail

dir="${SYLVARIS_DIR:-}"
if [ -z "$dir" ]; then
    here="$(dirname "$(readlink -f "$0")")"
    for d in "$here/../share/sylvaris" "$here/../shell"; do
        [ -f "$d/shell.qml" ] && dir="$(cd "$d" && pwd)" && break
    done
fi
[ -n "$dir" ] || { echo "sylvaris: cannot find the shell; set SYLVARIS_DIR to its folder" >&2; exit 1; }
sock="${XDG_RUNTIME_DIR:-/tmp}/sylvaris/ipc.sock"

usage() {
    cat <<'EOF'
Usage: sylvaris [command]

  (no command)                 start the shell
  greet                        start the SylGreet login screen (for greetd)
  filemanager1                 answer "Show in folder" from other apps over D-Bus (started by D-Bus)
  <part> [action] [args...]    run an action; `sylvaris list` shows them all
  center [toggle|open|close]   control SylCenter
  center view <name>           open SylCenter on a view
  theme [toggle|open|close|next|prev|apply|cycle|set <id>|list]
  state [topic]                print the shell state as JSON
  get <key>                    print a setting
  set <key> <value>            change a setting (JSON or plain text)
  settings [open <section>]    open SylSettings
  pick [prompt]                choose one of the lines on stdin in SylPad, like dmenu
  choose MULTI DIR SAVE PATH OUT
                               open or save dialog in SylFiles, for xdg-desktop-portal-termfilechooser
  config                       print where the configuration lives
  reload                       reload the shell
  list                         print every part and its actions
  watch [topic...]             stream state changes as JSON lines
  doctor                       print versions, missing tools and config problems for bug reports
  version                      print the Sylvaris version
EOF
}

json() {
    local out="" w
    for w in "$@"; do
        w="${w//\\/\\\\}"
        w="${w//\"/\\\"}"
        out+="${out:+,}\"$w\""
    done
    printf '[%s]' "$out"
}

request() {
    local reply="" sep=$'\x1f' req
    req="$(printf "%s$sep" "$@")"
    if [ ! -S "$sock" ]; then
        echo "error: Sylvaris is not running" >&2
        return 1
    fi
    reply="$(printf '%s' "$req" | sylstack msg "$sock")" || {
        echo "error: could not reach Sylvaris at $sock" >&2
        return 1
    }
    printf '%s\n' "$reply"
}

install_plugin() {
    local p="" answer=""
    run plugins install "$@"
    for _ in $(seq 600); do
        p="$(request plugins pending)"
        [ "$p" = fetching ] || break
        sleep 0.3
    done
    printf '%s\n' "$p"
    case "$p" in
    error:* | fetching | "") exit 1 ;;
    esac
    if [ -t 0 ]; then
        read -r -p "Install it? [y/N] " answer || answer=""
        case "$answer" in
        y | Y | yes) run plugins confirm ;;
        *) run plugins discard ;;
        esac
    fi
}

run() {
    local reply
    reply="$(request "$@")" || exit 1
    printf '%s\n' "$reply"
    case "$reply" in
    error:*) exit 1 ;;
    esac
}

case "${1:-}" in
"")
    exec sylstack -p "$dir" -n
    ;;
-h | --help | help)
    usage
    ;;
version | -V | --version)
    v="$(sed -n 's/^export const VERSION = "\(.*\)"$/\1/p' "$dir/lib/version.mjs" 2>/dev/null)"
    [ -n "$v" ] || exit 1
    printf 'Sylvaris %s\n' "$v"
    ;;
greet)
    exec sylstack -p "$dir/greet.qml" -n
    ;;
filemanager1)
    exec python3 "$dir/helpers/filemanager1.py" "$(readlink -f "$0")"
    ;;
view)
    run center view "${@:2}"
    ;;
pick)
    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT
    cat >"$tmp/in"
    mkfifo "$tmp/out"
    run pad pick "$tmp/in" "$tmp/out" "${@:2}" >/dev/null
    choice="$(cat "$tmp/out")"
    [ -n "$choice" ] || exit 1
    printf '%s\n' "$choice"
    ;;
choose)
    out="${6:-}"
    if [ -z "$out" ]; then
        echo "usage: sylvaris choose MULTIPLE DIRECTORY SAVE PATH OUT" >&2
        exit 2
    fi
    mode=open
    [ "${3:-0}" = 1 ] && mode=folder
    [ "${4:-0}" = 1 ] && mode=save
    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT
    mkfifo "$tmp/answer"
    exec 3<>"$tmp/answer"
    : >"$out"
    run files pick "$mode" "${2:-0}" "$tmp/answer" "${5:-}" >/dev/null
    while :; do
        if IFS= read -r -t 2 line <&3; then
            [ -n "$line" ] || break
            printf '%s\n' "$line" >>"$out"
        elif [ "$(request files picking "$tmp/answer")" != true ]; then
            break
        fi
    done
    ;;
reload)
    run shell reload
    ;;
config)
    run shell config
    ;;
state)
    if [ -n "${2:-}" ]; then run state get "$2"; else run state; fi
    ;;
get)
    run settings get "${@:2}"
    ;;
set)
    run settings set "${@:2}"
    ;;
doctor)
    out="$(mktemp)"
    trap 'rm -f "$out"' EXIT
    SYLVARIS_DOCTOR_OUT="$out" QT_QPA_PLATFORM=offscreen timeout 20 sylstack -p "$dir/doctor.qml" >/dev/null 2>&1 || true
    if [ ! -s "$out" ]; then
        echo "doctor could not start sylstack with $dir/doctor.qml" >&2
        exit 1
    fi
    cat "$out"
    ;;
capture)
    if [ "${2:-}" = edit ] && [ -n "${3:-}" ]; then run capture edit "$(realpath -m -- "$3")"; else run "$@"; fi
    ;;
notes)
    case "${2:-}" in
    open | window)
        files=()
        for p in "${@:3}"; do
            case "$p" in "~" | "~/"*) p="$HOME${p#\~}" ;; esac
            files+=("$(realpath -m -- "$p")")
        done
        run notes "$2" "${files[@]}"
        ;;
    *) run "$@" ;;
    esac
    ;;
plugins)
    if [ "${2:-}" = install ]; then install_plugin "${@:3}"; else run "$@"; fi
    ;;
watch)
    [ -S "$sock" ] || { echo "error: Sylvaris is not running" >&2; exit 1; }
    exec sylstack msg -f "$sock" "$(json watch "${@:2}")"
    ;;
*)
    run "$@"
    ;;
esac
